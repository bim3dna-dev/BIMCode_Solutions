# Optional public JSON contact endpoint. Empty uses the email-app fallback.
# Embedded in browser assets: never include secrets or credentials.
VITE_CONTACT_FORM_ENDPOINT=

# Server-only: never prefix these with VITE_. Add a real key only in local/Vercel secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Leave false until deployment rate limits and model access are verified.
AUDIT_ANALYSIS_ENABLED=false
# Exact website origin, without trailing slash. For local API development use http://localhost:5173.
AUDIT_ALLOWED_ORIGIN=https://www.bimcodesolutions.com
